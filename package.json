{
  "name": "botscent",
  "version": "0.0.0",
  "description": "Tells a website when software rather than a person is operating a visit, and names the agent when the evidence allows.",
  "keywords": [
    "bot",
    "agent",
    "ai-agent",
    "web-bot-auth",
    "bot-detection"
  ],
  "license": "MIT",
  "author": "Nalin Bhardwaj",
  "homepage": "https://botscent.nibnalin.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalinbhardwaj/botscent.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/botscent.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "default": "./dist/workers.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "default": "./dist/vercel.js"
    },
    "./botscent.js": "./dist/botscent.js",
    "./names.json": "./dist/names.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "botscent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "tsdown && cp src/generated/names.json dist/names.json && publint && attw --pack . --profile esm-only --exclude-entrypoints botscent.js --quiet && node scripts/size.ts",
    "typecheck": "tsc",
    "test": "node --test 'test/*.test.ts' 'test/adapters/*.test.ts'",
    "format": "prettier --write . && cd python && uv run ruff format .",
    "lint": "prettier --check . && node scripts/generate.ts --check && node scripts/vectors.ts --check && node scripts/docs.ts --check && node scripts/hygiene.ts",
    "vectors": "node scripts/vectors.ts",
    "test:browser": "node --test 'test/browser/*.test.ts'",
    "perf": "node test/perf/run.ts",
    "test:examples": "npm run build && node scripts/examples.ts",
    "test:runtimes": "node scripts/runtimes.ts && deno run --allow-read test/runtime/run.ts && bun test/runtime/run.ts",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/version.ts && prettier --write CHANGELOG.md"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "astro": "^7.3.5",
    "express": "^5.2.1",
    "hono": "^4.13.12",
    "miniflare": "^4.20260730.0",
    "next": "^16.3.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "astro": ">=4 <8",
    "express": ">=4 <6",
    "hono": ">=4 <5",
    "next": ">=14 <17",
    "react": ">=18 <20",
    "svelte": ">=4 <6",
    "vue": ">=3.3 <4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  }
}
