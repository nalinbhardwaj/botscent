{
  "name": "botscent",
  "version": "0.0.0",
  "description": "Tells a website when software rather than a person is operating a visit, and names the agent when the evidence allows.",
  "keywords": [
    "bot",
    "agent",
    "ai-agent",
    "web-bot-auth",
    "bot-detection"
  ],
  "license": "MIT",
  "author": "Nalin Bhardwaj",
  "homepage": "https://botscent.nibnalin.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalinbhardwaj/botscent.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/botscent.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./botscent.js": "./dist/botscent.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "tsdown && publint && attw --pack . --profile esm-only --exclude-entrypoints botscent.js --quiet && node scripts/size.ts",
    "typecheck": "tsc",
    "test": "node --test 'test/*.test.ts'",
    "format": "prettier --write . && cd python && uv run ruff format .",
    "lint": "prettier --check . && node scripts/generate.ts --check && node scripts/vectors.ts --check",
    "vectors": "node scripts/vectors.ts",
    "test:browser": "node --test 'test/browser/*.test.ts'"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^24.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
